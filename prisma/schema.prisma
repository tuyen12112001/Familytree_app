// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id         String   @id
  fullName   String
  gender     String
  birthDate  String
  deathDate  String?
  birthPlace String?
  zodiac     String?
  biography  String?
  avatarUrl  String?
  fatherId   String?
  motherId   String?
  spouseIds  String?
  childIds   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
